{
  "name": "cdm-portal",
  "version": "0.1.0",
  "description": "Frontend scaffold for the CDM Portal campus management system.",
  "author": "CDM Portal Team",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:mobile": "vite build --mode mobile",
    "build:emulator": "vite build --mode emulator",
    "preview": "vite preview",
    "mobile:sync": "npm run build:mobile && npx cap sync",
    "mobile:sync:emulator": "npm run build:emulator && npx cap sync",
    "mobile:add:android": "npx cap add android",
    "mobile:open:android": "npx cap open android",
    "mobile:add:ios": "npx cap add ios",
    "mobile:open:ios": "npx cap open ios",
    "desktop:dev": "vite build && electron .",
    "desktop:build": "vite build && electron-builder"
  },
  "dependencies": {
    "@capacitor/core": "^7.4.4",
    "axios": "^1.18.1",
    "pinia": "^3.0.3",
    "vue": "^3.5.16",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@capacitor/android": "^7.4.4",
    "@capacitor/cli": "^7.4.4",
    "@capacitor/ios": "^7.4.4",
    "@vitejs/plugin-vue": "^5.2.4",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.3.0"
  },
  "build": {
    "appId": "edu.cdm.portal",
    "productName": "CDM Portal",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "icon": "icon.ico",
      "target": "nsis"
    },
    "mac": {
      "icon": "icon.png",
      "target": "dmg"
    },
    "linux": {
      "icon": "icon.png",
      "target": "AppImage"
    }
  }
}
