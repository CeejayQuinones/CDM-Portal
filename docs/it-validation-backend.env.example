# IT-validation backend overlay only. Merge with backend/.env.example on a NEW test VM.
# Replace every example.invalid value and every empty required secret before starting.
# Never place this file on the live cdm-portal-server VM.

APP_ENV=production
APP_DEBUG=false
APP_URL=https://api-it.example.invalid
FRONTEND_URL=https://cdm-it.example.invalid
APP_KEY=
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cdm_portal_it_validation
DB_USERNAME=cdm_it_user
DB_PASSWORD=

# The Website origin is mandatory. Android's WebView uses https://localhost.
# Packaged Electron uses a null Origin; allow null only if Desktop is in scope.
CORS_ALLOWED_ORIGINS=https://cdm-it.example.invalid,https://localhost,null
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null
QUEUE_CONNECTION=database
CACHE_STORE=file

# Use dedicated test SMTP credentials and a test sender. OTP cannot use log/array.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=

# Keep bootstrap disabled except during the first, explicitly approved test seed.
PRODUCTION_BOOTSTRAP_ENABLED=false

# Configure test-specific Google OAuth credentials/callback only if that flow is tested.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api-it.example.invalid/auth/google/callback

# Current production-mode code requires Turnstile for guest registration and
# student account activation. Use a NEW test widget, never production keys.
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAMES=
