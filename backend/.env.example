APP_NAME="CDM Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Leave empty for normal local development.
# Production should list only trusted reverse-proxy IPs/CIDRs.
TRUSTED_PROXIES=

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost,https://localhost,capacitor://localhost,null

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local development uses XAMPP/MariaDB.
# IMPORTANT:
# DB_HOST is machine-specific when Laravel runs in WSL
# and MariaDB runs in Windows/XAMPP.
#
# Find the current Windows gateway from WSL with:
# ip route show default
#
# Then test:
# nc -zv <WINDOWS_GATEWAY> 3306
#
# Example only:
# DB_HOST=172.25.48.1

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=cdm_portal
DB_USERNAME=cdm_portal_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log

FILESYSTEM_DISK=local

QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=180
# REDIS_QUEUE_RETRY_AFTER=180
# BEANSTALKD_QUEUE_RETRY_AFTER=180

AI_DOCUMENT_ANALYZER=mock

GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_TIMEOUT=60

# Academic Monitoring AI Help
MONITORING_AI_ENABLED=false
MONITORING_AI_PROVIDER=disabled
MONITORING_AI_MODEL=
MONITORING_AI_BASE_URL=
MONITORING_AI_API_KEY=
MONITORING_AI_TIMEOUT=15

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="CDM PORTAL"

OCTANE_SERVER=frankenphp

# Admission recommendation AI
ADMISSION_GEMINI_API_KEY=
ADMISSION_GEMINI_MODEL=gemini-3.5-flash

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
