APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# Production: list only the reverse-proxy IP addresses/CIDRs that connect to Laravel.
# Leave empty when Laravel receives requests directly. Do not use * by default.
TRUSTED_PROXIES=

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost,capacitor://localhost,null

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production HTTPS deployments must set this to true.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=180
# REDIS_QUEUE_RETRY_AFTER=180
# BEANSTALKD_QUEUE_RETRY_AFTER=180

AI_DOCUMENT_ANALYZER=mock
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_TIMEOUT=60

# Advisory Academic Monitoring AI Help. Disabled uses the deterministic fallback.
# Supported providers: openai, gemini, ollama.
MONITORING_AI_ENABLED=false
MONITORING_AI_PROVIDER=disabled
MONITORING_AI_MODEL=
MONITORING_AI_BASE_URL=
MONITORING_AI_API_KEY=
MONITORING_AI_TIMEOUT=15

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Production FrankenPHP/Octane deployments should set this explicitly.
OCTANE_SERVER=frankenphp

# Admission recommendation AI. Configure only when the feature is enabled.
ADMISSION_GEMINI_API_KEY=
ADMISSION_GEMINI_MODEL=gemini-3.5-flash

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
