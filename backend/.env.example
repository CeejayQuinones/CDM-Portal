APP_NAME="CDM Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Leave empty for normal local development.
# Production should list only trusted reverse-proxy IPs/CIDRs.
TRUSTED_PROXIES=

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost,https://localhost,capacitor://localhost,null

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local development uses XAMPP/MariaDB.
# IMPORTANT:
# DB_HOST is machine-specific when Laravel runs in WSL
# and MariaDB runs in Windows/XAMPP.
#
# Find the current Windows gateway from WSL with:
# ip route show default
#
# Then test:
# nc -zv <WINDOWS_GATEWAY> 3306
#
# Example only:
# DB_HOST=172.25.48.1

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=cdm_portal
DB_USERNAME=cdm_portal_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SANCTUM_TOKEN_EXPIRATION=1440

BROADCAST_CONNECTION=log

FILESYSTEM_DISK=local

QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=180
# REDIS_QUEUE_RETRY_AFTER=180
# BEANSTALKD_QUEUE_RETRY_AFTER=180

# Optional informational weather context. Disabled until licensing/attribution is approved.
CAMPUS_WEATHER_ENABLED=false
CAMPUS_WEATHER_PROVIDER=open_meteo
CAMPUS_WEATHER_BASE_URL=https://api.open-meteo.com/v1/forecast
CAMPUS_WEATHER_LATITUDE=14.7314
CAMPUS_WEATHER_LONGITUDE=121.1447
CAMPUS_WEATHER_LOCATION="Rodriguez, Rizal"
CAMPUS_WEATHER_CACHE_MINUTES=45
CAMPUS_WEATHER_TIMEOUT=3

# One-time production bootstrap. Disable after the initial successful seed.
PRODUCTION_BOOTSTRAP_ENABLED=false
PRODUCTION_ADMIN_USERNAME=
PRODUCTION_ADMIN_PASSWORD=
PRODUCTION_ADMIN_EMAIL=
PRODUCTION_ADMIN_FIRST_NAME=
PRODUCTION_ADMIN_LAST_NAME=
PRODUCTION_REGISTRAR_USERNAME=
PRODUCTION_REGISTRAR_PASSWORD=
PRODUCTION_REGISTRAR_EMAIL=
PRODUCTION_REGISTRAR_FIRST_NAME=
PRODUCTION_REGISTRAR_LAST_NAME=
PRODUCTION_REGISTRAR_EMPLOYEE_NUMBER=

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="CDM PORTAL"
# Login OTP delivery rejects log/array mailers (including unsafe failover children)
# so one-time codes are never written to application logs. Configure a real mail transport.

OCTANE_SERVER=frankenphp

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Cloudflare Turnstile protects Website/PWA and Android authentication.
# The Site Key is public; the Secret Key must remain server-side.
# Official Cloudflare testing keys must never be used in production.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAMES=localhost
